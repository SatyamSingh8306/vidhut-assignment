# Vision-Based Elderly Monitoring System - Environment Configuration
# Copy this file to .env and fill in your values

# Required: API key for authentication (min 16 characters)
PATIENT_WATCH_API_KEY=your-secure-api-key-here-min-16-chars

# Required: MongoDB connection string
MONGODB_URL=mongodb://localhost:27017

# Optional: Database name (default: patient_watch)
PATIENT_WATCH_MONGODB_DATABASE=patient_watch

# Camera source: 0 for default webcam, or RTSP/HTTP URL, or video file path
PATIENT_WATCH_CAMERA_SOURCE=0

# YOLO pose model path (default: models/yolo11n-pose.pt)
PATIENT_WATCH_POSE_MODEL=models/yolo11n-pose.pt

# Help detection confirmation frames (default: 3)
PATIENT_WATCH_HELP_CONFIRM_FRAMES=3

# Automatic VLM capture interval in seconds (default: 10)
PATIENT_WATCH_CAPTURE_INTERVAL=10

# Audio monitoring (default: false)
PATIENT_WATCH_AUDIO_ENABLED=false

# Audio threshold for loud sound detection (0.0-1.0, default: 0.35)
PATIENT_WATCH_AUDIO_THRESHOLD=0.35

# Audio confirmation seconds (default: 1.0)
PATIENT_WATCH_AUDIO_CONFIRM_SECONDS=1.0

# Optional: Groq API key for cloud VLM analysis (fallback)
# GROQ_API_KEY=your-groq-api-key

# Optional: Groq vision model (default: qwen/qwen3.8-27b)
PATIENT_WATCH_GROQ_VISION_MODEL=qwen/qwen3.8-27b

# VLM settings (local LLaVA)
PATIENT_WATCH_VLM_MODEL=llava-hf/llava-v1.6-mistral-7b-hf
PATIENT_WATCH_VLM_LOAD_IN_4BIT=true
PATIENT_WATCH_VLM_MAX_TOKENS=256
PATIENT_WATCH_VLM_TEMPERATURE=0.1
PATIENT_WATCH_VLM_INTERVAL=30

# Multimodal feature toggles
PATIENT_WATCH_ENABLE_FACIAL_EXPRESSION=true
PATIENT_WATCH_ENABLE_HAND_GESTURE=true
PATIENT_WATCH_ENABLE_ISL=true
PATIENT_WATCH_ENABLE_VISUAL_SPEECH=true
PATIENT_WATCH_ENABLE_VLM_REASONING=true
PATIENT_WATCH_ENABLE_PERSONALIZATION=true

# Processing
PATIENT_WATCH_PROCESS_EVERY_N_FRAMES=2